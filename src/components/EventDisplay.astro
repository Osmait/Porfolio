---
import { PROFILE } from "../data/profile";
import { PROJECTS, KIND_LABEL, techEnergy, type Project } from "../data/projects";
import { R, f, pol, sector, curl, toPath, layerHits, farthest, radiusFromCommits, spread } from "../lib/detector";

export interface PostLite {
  id: string;
  title: string;
  description: string;
  date: string;
  minutes: number;
  tags: string[];
}
interface Props {
  posts: PostLite[];
}
const { posts } = Astro.props;

const featured = PROJECTS.filter((p) => p.featured);
const secondary = PROJECTS.filter((p) => !p.featured);
const TOTAL = PROJECTS.length;
const TECH = techEnergy().filter((t) => t.n >= 2).slice(0, 18);
const MAXN = Math.max(...TECH.map((t) => t.n));

// Stiff tracks: featured projects punch through to the muon chambers.
const stiffAngles = spread(featured.length, -125);
const stiff = featured.map((p, i) => {
  const a = stiffAngles[i];
  const [x0, y0] = pol(R.pipe + 3, a),
    [x1, y1] = pol(R.mu[2][1] + 4, a);
  const [lx, ly] = pol(R.phi + 20, a);
  const c = Math.cos((a * Math.PI) / 180),
    s = Math.sin((a * Math.PI) / 180);
  const anchor = c >= 0.05 ? "start" : c < -0.05 ? "end" : "middle";
  const dy = s > 0.6 ? 16 : s < -0.6 ? -18 : 0;
  return {
    p,
    d: `M${f(x0)} ${f(y0)}L${f(x1)} ${f(y1)}`,
    hits: R.layers.map((L) => pol(L, a)),
    chambers: R.mu.map(([r0, r1]) => pol((r0 + r1) / 2, a)),
    a,
    label: { x: f(lx), y: f(ly + dy), anchor },
    foc: pol(R.mu[2][1] + 4, a),
  };
});

// Curling tracks: secondary projects, radius from commit history.
const curlAngles = spread(secondary.length, -125 + 360 / featured.length / 2 + 8);
const curly = secondary.map((p, i) => {
  const rad = radiusFromCommits(p.commits);
  const pts = curl(curlAngles[i], rad, i % 2 ? -1 : 1, R.trkOut - 2);
  const { far, fr } = farthest(pts);
  const ux = far[0] / fr,
    uy = far[1] / fr;
  let lx, ly, anchor;
  if (fr > 190) {
    lx = far[0] - ux * 18;
    ly = far[1] - uy * 18 + (uy < 0 ? 16 : -8);
    anchor = ux >= 0 ? "end" : "start";
  } else {
    lx = far[0] + ux * 12;
    ly = far[1] + uy * 12 + 5;
    anchor = ux >= 0 ? "start" : "end";
  }
  return { p, d: toPath(pts), hits: layerHits(pts), label: { x: f(lx), y: f(ly), anchor }, far, rad };
});

// Photons: logbook entries, straight and neutral, stopping in the calorimeter.
const photonAngles = spread(Math.max(Math.min(posts.length, 8), 1), -125 + 360 / featured.length / 2 + 8 + 180 / secondary.length);
const photons = posts.slice(0, 8).map((post, i) => {
  const a = photonAngles[i];
  const [x0, y0] = pol(R.pipe + 3, a),
    [x1, y1] = pol(R.calIn + 12, a);
  const [lx, ly] = pol(R.calIn - 22, a);
  return { post, d: `M${f(x0)} ${f(y0)}L${f(x1)} ${f(y1)}`, label: { x: f(lx), y: f(ly), anchor: Math.cos((a * Math.PI) / 180) >= 0 ? "end" : "start" }, end: [f(x1), f(y1)] };
});

// Calorimeter towers: technologies, height = projects using them.
const towerAngles = spread(TECH.length, 6);
const towers = TECH.map((t, i) => {
  const a = towerAngles[i];
  const la = a + 5.2,
    right = Math.cos((la * Math.PI) / 180) >= 0;
  return {
    t,
    hit: sector(R.calIn - 2, R.calOut + 2, a - 3, a + 9.5),
    frame: sector(R.calIn, R.calOut, a - 2.4, a + 2.4),
    bar: sector(R.calIn, R.calIn + ((R.calOut - R.calIn) * t.n) / MAXN, a - 2.4, a + 2.4),
    label: { rot: f(right ? la : la + 180), x: right ? R.calIn + 6 : -(R.calIn + 6), anchor: right ? "start" : "end" },
  };
});

// Static detector furniture
const phiTicks = Array.from({ length: 72 }, (_, k) => {
  const a = k * 5,
    long = a % 30 === 0;
  const [x0, y0] = pol(R.phi, a),
    [x1, y1] = pol(R.phi + (long ? 10 : 5), a);
  return { x0: f(x0), y0: f(y0), x1: f(x1), y1: f(y1), long };
});
const muon = R.mu.flatMap(([r0, r1], s) =>
  Array.from({ length: 12 }, (_, k) => sector(r0, r1, k * 30 + 1.6 + (s % 2) * 0.8, (k + 1) * 30 - 1.6)),
);
const calLines = Array.from({ length: 60 }, (_, k) => {
  const a = 9 + k * 6;
  const [x0, y0] = pol(R.calIn, a),
    [x1, y1] = pol(R.calOut, a);
  return [f(x0), f(y0), f(x1), f(y1)];
});

const kindColor = (p: Project) => (p.kind === "backend" ? "c" : "y");

// Data for the readout, serialised once for the client script.
const readout = {
  projects: Object.fromEntries(
    PROJECTS.map((p) => [
      p.id,
      {
        title: p.title,
        kind: KIND_LABEL[p.kind],
        cls: kindColor(p),
        stiff: p.featured,
        summary: p.summary,
        tech: p.tech,
        updated: p.updated,
        commits: p.commits,
        repo: p.repo,
        demo: p.demo ?? null,
        note: p.note ?? null,
      },
    ]),
  ),
  tech: Object.fromEntries(TECH.map((t) => [t.name, { n: t.n, used: t.used }])),
  posts: Object.fromEntries(posts.map((p) => [p.id, p])),
  total: TOTAL,
};
const [sy, sm] = PROFILE.role.start.split("-").map(Number);
const since = new Date(Date.UTC(sy, sm - 1, 1)).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const today = new Date().toISOString().slice(0, 10);
---

<section class="event" aria-label={`Event display: ${PROFILE.name}`}>
  <div class="summary">
    <dl class="runhdr">
      <div><dt>Run</dt><dd>{today.slice(0, 4)}</dd></div>
      <div><dt>Tracks</dt><dd>{TOTAL}</dd></div>
      <div><dt>Built</dt><dd>{today}</dd></div>
    </dl>
    <h1 class="name">{PROFILE.name}</h1>
    <p class="role">
      {PROFILE.role.title} at {PROFILE.role.company}
      <span>{PROFILE.role.arrangement} · since {since}</span>
    </p>
    <p class="lede">{PROFILE.focus}</p>
    <ul class="doors">
      <li>
        <a class="c" href="#tracks">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 16L16 2" stroke="#3FD3E0" stroke-width="1.5" stroke-linecap="round"></path><rect x="11.5" y="4.5" width="4" height="2" transform="rotate(-45 13.5 5.5)" fill="#3FD3E0"></rect></svg>
          <span class="d-t">Projects</span><span class="d-m">{TOTAL} public repos</span>
        </a>
      </li>
      <li>
        <a class="y" href="/blog">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9H16" stroke="#E8ECF1" stroke-width="1.5" stroke-dasharray="3 2.5"></path></svg>
          <span class="d-t">Logbook</span><span class="d-m">{posts.length ? `${posts.length} ${posts.length === 1 ? "entry" : "entries"}` : "first entry soon"}</span>
        </a>
      </li>
      <li>
        <a href={`mailto:${PROFILE.email}`}>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="1.5" y="4" width="15" height="10" fill="none" stroke="#E8ECF1" stroke-width="1.3"></rect><path d="M1.5 4.5L9 10l7.5-5.5" fill="none" stroke="#E8ECF1" stroke-width="1.3"></path></svg>
          <span class="d-t">Contact</span><span class="d-m">{PROFILE.email}</span>
        </a>
      </li>
    </ul>
  </div>

  <figure class="display">
    <svg
      id="det"
      class="det"
      viewBox="-720 -560 1440 1120"
      role="group"
      aria-label="Detector cross-section. Straight tracks are featured projects, curling tracks are smaller projects, dashed lines are logbook entries, red towers are technologies sized by how many projects use them. Every track can be focused with Tab."
    >
      <g id="det-g">
        <g aria-hidden="true" class="furniture">
          {phiTicks.map((t) => <line x1={t.x0} y1={t.y0} x2={t.x1} y2={t.y1} stroke="#5C7896" stroke-opacity={t.long ? 0.7 : 0.35} />)}
          <circle r={R.phi} class="ring" stroke-opacity=".35"></circle>
          {muon.map((d) => <path d={d} fill="#5C7896" fill-opacity=".1" stroke="#5C7896" stroke-opacity=".55" />)}
          <path d={sector(R.calIn, R.calOut, 0, 179.99) + sector(R.calIn, R.calOut, 180, 359.99)} fill="#5C7896" fill-opacity=".05"></path>
          {[R.calIn, R.calMid, R.calOut].map((r) => <circle r={r} class="ring" stroke-opacity=".5" />)}
          {calLines.map(([x0, y0, x1, y1]) => <line x1={x0} y1={y0} x2={x1} y2={y1} stroke="#5C7896" stroke-opacity=".22" />)}
          <circle r={R.sol} class="ring" stroke-opacity=".7" stroke-width="2.5"></circle>
          <circle r={R.sol + 4} class="ring" stroke-opacity=".3"></circle>
          <circle r={R.trkOut} fill="#5C7896" fill-opacity=".035"></circle>
          {R.layers.map((r, i) => <circle r={r} class="ring" stroke-opacity={i < 3 ? 0.5 : 0.28} stroke-dasharray={i < 3 ? undefined : "2 3"} />)}
          <circle r={R.pipe} class="ring" stroke-opacity=".8"></circle>
        </g>

        <g class="sel">
          {
            towers.map(({ t, hit, frame, bar, label }, i) => (
              <g class="tower sel-able" tabindex="0" role="button" data-id={`x:${t.name}`} aria-label={`${t.name}: used by ${t.n} of ${TOTAL} projects`}>
                <path class="hit" d={hit} />
                <path d={frame} fill="none" stroke="#E5483B" stroke-opacity=".35" />
                <path class="bar" d={bar} style={`--i:${i}`} />
                <text class="tl" transform={`rotate(${label.rot})`} x={label.x} y="4" text-anchor={label.anchor}>
                  {t.name}
                  <tspan class="tn"> {t.n}/{TOTAL}</tspan>
                </text>
              </g>
            ))
          }

          {
            photons.map(({ post, d, label, end }) => (
              <g class="trk ph sel-able" tabindex="0" role="button" data-id={`p:${post.id}`} aria-label={`Logbook entry: ${post.title}, ${post.minutes} minute read`}>
                <path class="hit" d={d} />
                <path class="ln" d={d} />
                <rect x={end[0] - 3} y={end[1] - 3} width="6" height="6" fill="#E8ECF1" />
                <text class="lb" x={label.x} y={label.y} text-anchor={label.anchor}>{post.title.length > 28 ? post.title.slice(0, 27) + "…" : post.title}</text>
              </g>
            ))
          }

          {
            curly.map(({ p, d, hits, label, far }) => (
              <g class={`trk ${kindColor(p)} soft sel-able`} tabindex="0" role="button" data-id={`t:${p.id}`} aria-label={`Project ${p.title}: ${p.tech.length} technologies`}>
                <path class="hit" d={d} />
                <path class="ln" d={d} pathLength="1" />
                {hits.map(([x, y]) => <rect class="pt" x={f(x - 2)} y={f(y - 2)} width="4" height="4" />)}
                <text class="lb sm curl-lb" x={label.x} y={label.y} text-anchor={label.anchor}>{p.title}</text>
                <circle class="foc" cx={f(far[0])} cy={f(far[1])} r="9" />
              </g>
            ))
          }

          {
            stiff.map(({ p, d, hits, chambers, a, label, foc }) => (
              <g class={`trk ${kindColor(p)} sel-able`} tabindex="0" role="button" data-id={`t:${p.id}`} aria-label={`Project ${p.title}: ${p.tech.length} technologies`}>
                <path class="hit" d={d} />
                <path class="ln" d={d} pathLength="1" />
                {hits.map(([x, y]) => <rect class="pt" x={f(x - 2)} y={f(y - 2)} width="4" height="4" />)}
                {chambers.map(([x, y]) => <rect class="pt" x={f(x - 7)} y={f(y - 4)} width="14" height="8" transform={`rotate(${f(a)} ${f(x)} ${f(y)})`} />)}
                <text class="lb" x={label.x} y={label.y} text-anchor={label.anchor}>{p.title}</text>
                <text class="lb2" x={label.x} y={label.y + 17} text-anchor={label.anchor}>{p.tech.slice(0, 3).join(" · ")}</text>
                <circle class="foc" cx={f(foc[0])} cy={f(foc[1])} r="10" />
              </g>
            ))
          }
        </g>
      </g>

      <circle r="3" fill="#E8ECF1"></circle>
      <g class="vtx" pointer-events="none" aria-hidden="true">
        <path d="M-3 3L-26 26H-40" stroke="#8E99A8" fill="none"></path>
        <rect x="-156" y="15" width="116" height="22" fill="#07090D" stroke="#5C7896" stroke-opacity=".6"></rect>
        <text x="-98" y="30.5" fill="#E8ECF1" font-size="12.5" text-anchor="middle" class="mono">vertex: osmait</text>
      </g>
    </svg>
    <p class="cap tl">Transverse view · x–y plane</p>
    <dl class="legend" aria-label="Legend">
      <dt><svg width="30" height="12" viewBox="0 0 30 12" aria-hidden="true"><path d="M1 6H29" stroke="#3FD3E0" stroke-width="1.8"></path></svg></dt>
      <dd>{KIND_LABEL.backend}</dd>
      <dt><svg width="30" height="12" viewBox="0 0 30 12" aria-hidden="true"><path d="M1 6H29" stroke="#F2D23C" stroke-width="1.8"></path></svg></dt>
      <dd>{KIND_LABEL.systems}</dd>
      <dt><svg width="30" height="12" viewBox="0 0 30 12" aria-hidden="true"><path d="M1 11C8 11 16 9 20 5c3-3 8-2 7 2" fill="none" stroke="#8E99A8" stroke-width="1.6"></path></svg></dt>
      <dd>Straight: featured · curling: smaller, radius from commits</dd>
      <dt><svg width="30" height="12" viewBox="0 0 30 12" aria-hidden="true"><path d="M1 6H29" stroke="#E8ECF1" stroke-width="1.4" stroke-dasharray="4 3"></path></svg></dt>
      <dd>Logbook entry{posts.length === 0 && <span class="zero"> · none recorded yet</span>}</dd>
      <dt><svg width="30" height="12" viewBox="0 0 30 12" aria-hidden="true"><rect x="1" y="3" width="20" height="6" fill="#E5483B"></rect><rect x="1" y="3" width="28" height="6" fill="none" stroke="#E5483B" stroke-opacity=".4"></rect></svg></dt>
      <dd>Technology · height = projects using it</dd>
    </dl>
    <p class="cap br">Hover, tab or tap a track to isolate it. Esc clears.</p>
  </figure>

  <aside class="readout" id="readout" aria-labelledby="ro-h">
    <div class="ro-head"><h2 id="ro-h">Readout</h2><span class="ro-state" id="ro-state">no selection</span></div>
    <div id="ro-body" aria-live="polite">
      <p class="ro-idle">Nothing isolated yet. Pick any line or tower in the display to read its details here.</p>
      <dl class="ro-tot">
        <dt><svg width="22" height="10" viewBox="0 0 22 10" aria-hidden="true"><path d="M1 5H21" stroke="#8E99A8" stroke-width="1.8"></path></svg></dt><dd class="k">Featured projects</dd><dd>{featured.length}</dd>
        <dt><svg width="22" height="10" viewBox="0 0 22 10" aria-hidden="true"><path d="M1 9C7 9 13 6 16 3c2-2 5 0 3 3" fill="none" stroke="#8E99A8" stroke-width="1.6"></path></svg></dt><dd class="k">Smaller projects</dd><dd>{secondary.length}</dd>
        <dt><svg width="22" height="10" viewBox="0 0 22 10" aria-hidden="true"><path d="M1 5H21" stroke="#E8ECF1" stroke-width="1.4" stroke-dasharray="4 3"></path></svg></dt><dd class="k">Logbook entries</dd><dd>{posts.length}</dd>
        <dt><svg width="22" height="10" viewBox="0 0 22 10" aria-hidden="true"><rect x="1" y="2" width="14" height="6" fill="#E5483B"></rect></svg></dt><dd class="k">Technologies shown</dd><dd>{TECH.length}</dd>
      </dl>
    </div>
  </aside>
</section>

<script type="application/json" id="readout-data" set:html={JSON.stringify(readout)} />

<script>
  type RO = {
    projects: Record<string, { title: string; kind: string; cls: string; stiff: boolean; summary: string; tech: string[]; updated: string; commits: number; repo: string; demo: string | null; note: string | null }>;
    tech: Record<string, { n: number; used: string[] }>;
    posts: Record<string, { id: string; title: string; description: string; date: string; minutes: number; tags: string[] }>;
    total: number;
  };
  const data: RO = JSON.parse(document.getElementById("readout-data")!.textContent!);
  const svg = document.getElementById("det")!;
    const ro = document.getElementById("ro-body")!;
  const state = document.getElementById("ro-state")!;
  const box = document.getElementById("readout")!;
  const idle = ro.innerHTML;
  const groups = [...svg.querySelectorAll<SVGGElement>("[data-id]")];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const fmt = (d: string) => new Date(d + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

  function render(id: string | null) {
    if (!id) {
      ro.innerHTML = idle;
      state.textContent = "no selection";
      state.classList.remove("on");
      box.classList.remove("sel");
      return;
    }
    box.classList.add("sel");
    state.classList.add("on");
    const [type, key] = [id.slice(0, 1), id.slice(2)];
    if (type === "t") {
      const p = data.projects[key];
      state.textContent = "isolated: " + p.title;
      ro.innerHTML = `<p class="ro-kind ${p.cls}">${p.stiff ? "Straight track" : "Curling track"} · ${esc(p.kind)}</p>
        <h3 class="ro-title">${esc(p.title)}</h3><p class="ro-text">${esc(p.summary)}</p>
        <dl class="ro-kv"><dt>Tech</dt><dd>${p.tech.map(esc).join(", ")}</dd><dt>Updated</dt><dd>${fmt(p.updated)}</dd>${p.note ? `<dt>Note</dt><dd>${esc(p.note)}</dd>` : ""}</dl>
        <p class="ro-links"><a class="ro-go" href="https://github.com/${p.repo}">github.com/${esc(p.repo)}</a>${p.demo ? `<a class="ro-go" href="${p.demo}">Live demo</a>` : ""}</p>`;
    } else if (type === "x") {
      const t = data.tech[key];
      state.textContent = "isolated: " + key;
      const names = t.used.map((u) => data.projects[u].title);
      ro.innerHTML = `<p class="ro-kind e">Calorimeter tower · technology</p><h3 class="ro-title">${esc(key)}</h3>
        <dl class="ro-kv"><dt>Energy</dt><dd>${t.n} of ${data.total} projects</dd><dt>Seen in</dt><dd>${names.map(esc).join(", ")}</dd></dl>`;
    } else {
      const p = data.posts[key];
      state.textContent = "isolated: logbook";
      ro.innerHTML = `<p class="ro-kind w">Logbook entry · ${fmt(p.date)}</p><h3 class="ro-title">${esc(p.title)}</h3><p class="ro-text">${esc(p.description)}</p>
        <dl class="ro-kv"><dt>Reading</dt><dd>${p.minutes} min</dd><dt>Tags</dt><dd>${p.tags.map(esc).join(", ")}</dd></dl>
        <a class="ro-go" href="/blog/${p.id}/">Read entry</a>`;
    }
  }

  let pinned: string | null = null;
  function isolate(id: string | null) {
    const used = id?.startsWith("x:") ? data.tech[id.slice(2)].used.map((u) => "t:" + u) : [];
    for (const g of groups) {
      const k = g.dataset.id!;
      g.classList.toggle("on", k === id || used.includes(k));
      g.setAttribute("aria-pressed", k === pinned ? "true" : "false");
    }
    svg.classList.toggle("has-sel", !!id);
    render(id);
  }
  for (const g of groups) {
    const id = g.dataset.id!;
    g.addEventListener("mouseenter", () => isolate(id));
    g.addEventListener("mouseleave", () => isolate(pinned));
    g.addEventListener("focus", () => isolate(id));
    g.addEventListener("blur", () => isolate(pinned));
    g.addEventListener("click", () => {
      pinned = pinned === id ? null : id;
      isolate(pinned ?? id);
    });
    g.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        pinned = pinned === id ? null : id;
        isolate(id);
      }
    });
  }
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      pinned = null;
      isolate(null);
    }
  });
  svg.addEventListener("click", (e) => {
    if (e.target === svg) {
      pinned = null;
      isolate(null);
    }
  });

  // One collision replay on load: tracks leave the vertex, towers fill.
  // Everything is fully drawn by default; the replay only runs when motion is welcome.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    svg.classList.add("fire");
    setTimeout(() => svg.classList.remove("fire"), 2600);
  }
</script>

<style>
  .event {
    display: grid;
    grid-template-columns: minmax(360px, 408px) 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas: "sum disp" "ro disp";
    height: calc(100svh - var(--bar-h));
    min-height: 740px;
    max-height: 1100px;
    border-bottom: 1px solid var(--rule);
  }
  .summary {
    grid-area: sum;
    border-right: 1px solid var(--rule);
    padding: 0 var(--gut) 20px;
  }
  .readout {
    grid-area: ro;
    border-right: 1px solid var(--rule);
    border-top: 1px solid var(--rule);
    padding: 18px var(--gut) 24px;
    min-height: 0;
    overflow: auto;
  }
  .display {
    grid-area: disp;
    position: relative;
    margin: 0;
    min-width: 0;
    min-height: 0;
  }
  .display svg {
    width: 100%;
    height: 100%;
  }

  .runhdr {
    display: grid;
    grid-template-columns: auto auto 1fr;
    border-bottom: 1px solid var(--rule);
    margin: 0 calc(var(--gut) * -1) 24px;
    padding: 0 var(--gut);
  }
  .runhdr div {
    padding: 11px 16px 10px 0;
    margin-right: 16px;
    border-right: 1px solid var(--rule);
  }
  .runhdr div:last-child {
    border: 0;
    margin: 0;
    text-align: right;
    padding-right: 0;
  }
  .runhdr dt {

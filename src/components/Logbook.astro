---
import type { PostLite } from "./EventDisplay.astro";

interface Props {
  posts: PostLite[];
  limit?: number;
}
const { posts, limit } = Astro.props;
const shown = limit ? posts.slice(0, limit) : posts;
---

{
  shown.length > 0 ? (
    <table class="log">
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Entry</th>
          <th scope="col" class="r">Read</th>
          <th scope="col">Tags</th>
        </tr>
      </thead>
      <tbody>
        {shown.map((p) => (
          <tr>
            <td class="c-dt">
              <time datetime={p.date}>{p.date}</time>
            </td>
            <td class="c-tl">
              <a href={`/blog/${p.id}/`}>{p.title}</a>
              <p>{p.description}</p>
            </td>
            <td class="c-rt">{p.minutes} min</td>
            <td class="c-tg">
              <ul class="tags">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <div class="empty">
      <svg viewBox="-60 -60 120 120" width="120" height="120" aria-hidden="true">
        <circle r="54" fill="none" stroke="#5C7896" stroke-opacity=".6" />
        <circle r="36" fill="none" stroke="#5C7896" stroke-opacity=".35" stroke-dasharray="2 3" />
        <circle r="18" fill="none" stroke="#5C7896" stroke-opacity=".35" stroke-dasharray="2 3" />
        <path d="M4 -2L50 -20" stroke="#E8ECF1" stroke-width="1.4" stroke-dasharray="5 4" opacity=".35" />
        <circle r="2.5" fill="#E8ECF1" />
      </svg>
      <div>
        <p class="e-h">No entries recorded yet.</p>
        <p>
          The logbook is where I write down how things work from the inside: databases, syscalls, queues and the services
          on top of them. The first entry is on its way.
        </p>
        <p class="e-sub">
          Follow along with the <a href="/rss.xml">RSS feed</a>, or on <a href="https://github.com/Osmait">GitHub</a>.
        </p>
      </div>
    </div>
  )
}

<style>
  table.log {
    width: 100%;
    border-collapse: collapse;
  }
  .log th {
    font: 500 11px/1 var(--f-label);
    font-stretch: 78%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    text-align: left;
    padding: 0 16px 12px 0;
    border-bottom: 1px solid var(--rule-2);
  }
  .log th.r {
    text-align: right;
    padding-right: 32px;
  }
  .log td {
    padding: 20px 16px 20px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .c-dt {
    font: 400 13px/1.5 var(--f-mono);
    color: var(--dim);
    width: 118px;
    white-space: nowrap;
  }
  .c-rt {
    font: 400 13px/1.5 var(--f-mono);
    color: var(--ink-2);
    width: 78px;
    text-align: right;
    padding-right: 32px !important;
    white-space: nowrap;
  }
  .c-tg {
    width: 230px;
  }
  .c-tl a {
    font: 600 21px/1.2 var(--f-label);
    font-stretch: 90%;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 6px;
  }
  .c-tl p {
    margin: 0;
    color: var(--dim);
    font-size: 15px;
    line-height: 1.5;
    max-width: 62ch;
  }
  .log tr:hover .c-tl a,
  .c-tl a:focus-visible {
    color: var(--yel);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tags li {
    font: 500 12px/1 var(--f-label);
    font-stretch: 82%;
    color: var(--ink-2);
    border: 1px solid var(--rule-2);
    padding: 5px 7px 4px;
  }

  .empty {
    display: grid;
    grid-template-columns: 120px minmax(0, 60ch);
    gap: 32px;
    align-items: center;
    padding: 28px 0;
    border-top: 1px solid var(--rule-2);
    border-bottom: 1px solid var(--rule);
  }
  .empty p {
    margin: 0 0 10px;
    color: var(--ink-2);
    font-size: 16px;
  }
  .empty .e-h {
    font: 600 22px/1.2 var(--f-label);
    font-stretch: 88%;
    color: var(--ink);
  }
  .empty .e-sub {
    color: var(--dim);
    font-size: 14.5px;
    margin: 0;
  }

  @media (max-width: 820px) {
    table.log,
    .log tbody,
    .log tr,
    .log td {
      display: block;
      width: auto;
    }
    .log thead {
      display: none;
    }
    .log tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
      padding: 18px 0;
      border-bottom: 1px solid var(--rule);
    }
    .log td {
      border: 0;
      padding: 0 !important;
    }
    .c-dt,
    .c-rt {
      width: auto;
    }
    .c-tl,
    .c-tg {
      grid-column: 1 / -1;
      width: auto;
    }
    .c-tg {
      margin-top: 6px;
    }
    .empty {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .empty svg {
      width: 80px;
      height: 80px;
    }
  }
</style>

---
import { Font } from "astro:assets";
import "../styles/global.css";
import Mark from "../components/Mark.astro";

interface Props {
  title: string;
  description: string;
  current?: "display" | "logbook" | "tracks" | "config" | "contact";
  type?: "website" | "article";
}

const { title, description, current = "display", type = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const onHome = Astro.url.pathname === "/";
const to = (hash: string) => (onHome ? `#${hash}` : `/#${hash}`);

const nav = [
  { key: "display", label: "Display", href: onHome ? "#top" : "/" },
  { key: "logbook", label: "Logbook", href: "/blog" },
  { key: "tracks", label: "Tracks", href: to("tracks") },
  { key: "config", label: "Detector config", href: to("config") },
  { key: "contact", label: "Contact", href: to("contact") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Osmait logbook" href="/rss.xml" />
    <meta name="theme-color" content="#07090D" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="José Saúl Burgos" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <Font cssVariable="--font-label" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-read" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <a class="mark" href="/" aria-label="José Saúl Burgos, home">
        <Mark />
      </a>
      <nav aria-label="Primary">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={n.key === current ? "page" : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
      <slot name="bar" />
    </header>
    <slot />
  </body>
</html>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--bar-h);
    padding: 0 var(--gut);
    background: rgba(7, 9, 13, 0.94);
    border-bottom: 1px solid var(--rule);
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font: 600 15px/1 var(--f-label);
    font-stretch: 88%;
    letter-spacing: 0.01em;
  }
  nav {
    display: flex;
    gap: 2px;
  }
  nav a {
    font: 500 12.5px/1 var(--f-label);
    font-stretch: 80%;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--dim);
    padding: 10px 12px;
    position: relative;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current] {
    color: var(--ink);
  }
  nav a[aria-current]::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 3px;
    height: 1px;
    background: var(--cyan);
  }
  @media (max-width: 820px) {
    .bar {
      height: auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 10px var(--gut) 0;
    }
    nav {
      margin: 4px -10px 0;
      flex-wrap: wrap;
    }
    nav a {
      padding: 10px 10px 9px;
      font-size: 12px;
    }
    nav a:first-child {
      display: none;
    }
  }
</style>
